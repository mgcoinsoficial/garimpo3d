# Variáveis de ambiente — copie este arquivo para a configuração do Railway
# (Settings → Variables → Raw Editor)
#
# Tudo é opcional. O servidor sobe mesmo sem nenhuma variável definida
# (entra em modo dry-run e não consegue buscar ofertas dos marketplaces).

# ===== WhatsApp Cloud API (Meta) =====
# Phone Number ID — pegue em whatsapp.com/business → API Setup
WA_PHONE_NUMBER_ID=

# Access Token permanente (recomendado System User Token)
WA_ACCESS_TOKEN=

# String secreta que você vai repetir na Meta ao configurar o webhook
WA_WEBHOOK_VERIFY_TOKEN=garimpo-3d-verify

# IDs dos grupos alvo (separados por vírgula, formato 12036...@g.us)
# Você pode adicionar/remover depois pelo painel — esta env é só o seed inicial
WA_TARGET_GROUPS=

# ===== Afiliados =====
SHOPEE_AFFILIATE_ID=
ML_AFFILIATE_ID=
ALIEXPRESS_TRACKING_ID=

# ===== Operação =====
# Intervalo entre varreduras automáticas (em minutos)
SCAN_INTERVAL_MIN=15

# Desconto mínimo pra considerar uma oferta (%)
MIN_DISCOUNT_PCT=20

# Ambiente
NODE_ENV=production
